// Portfolio Management System Schema
// Multi-tenant portfolio architecture with user profiles and project sub-schemas

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User model - core authentication entity
// Each user gets a unique handle for public portfolio URL
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One-to-one relationship with Profile
  profile Profile?
}

// Profile model - extends User with portfolio data
// Contains bio, social links, and profile picture
model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  bio         String   @default("")
  avatarUrl   String   @default("")
  title       String   @default("")
  location    String   @default("")
  website     String   @default("")
  github      String   @default("")
  linkedin    String   @default("")
  twitter     String   @default("")
  skills      String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects Project[]
}

// Project sub-schema - individual portfolio items
// Supports tech tags and media arrays stored as JSON
model Project {
  id          String   @id @default(cuid())
  profileId   String
  title       String
  description String   @default("")
  link        String   @default("")
  repoUrl     String   @default("")
  techTags    String   @default("[]")
  mediaUrls   String   @default("[]")
  order       Int      @default(0)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}
